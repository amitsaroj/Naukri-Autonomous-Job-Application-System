# Naukri auth is done once via `npm run login` in a real browser window.
# No Naukri password is ever stored in this file or in code.

# --- Run mode ---
DRY_RUN=true

# --- Browser ---
BROWSER_PROFILE_DIR=./naukri-browser-profile
BROWSER_HEADLESS=false

# --- Job freshness / search ---
MAX_JOB_AGE_DAYS=3
# Comma-separated. Override to change the default keyword set.
SEARCH_KEYWORDS=React Developer,React.js Developer,Full Stack Developer,MERN Developer,MERN Stack Developer,Node.js Developer,Next.js Developer,Senior React Developer,Senior Full Stack Developer,Software Engineer,Full Stack Engineer,Node.js Backend Developer

# --- Matching ---
MIN_MATCH_SCORE=70

# --- Limits (never hammer the site) ---
MAX_APPLICATIONS_PER_RUN=30
MAX_APPLICATIONS_PER_DAY=50
DELAY_BETWEEN_APPLICATIONS_MIN_SEC=10
DELAY_BETWEEN_APPLICATIONS_MAX_SEC=30

# --- Paths ---
DATABASE_PATH=./data/naukri-agent.db
PROFILE_CONFIG_PATH=./config/profile.json
KEYWORDS_CONFIG_PATH=./config/keywords.json
QUESTION_PATTERNS_PATH=./config/question-patterns.json
RESUME_PATH=./resumes/Amit_Saroj_Senior_Full_Stack_Engineer(MERN).pdf
LOG_DIR=./logs

LOG_LEVEL=info
